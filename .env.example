# OpenAI — only needed for AddTaskBar "AI" button / npm run ai:smoke
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# AI server (Node.js sidecar for LLM calls)
AI_SERVER_PORT=8787
NODE_ENV=development

# Optional: override dev proxy target from Vite
# VITE_AI_SERVER_URL=http://127.0.0.1:8787/api/ai