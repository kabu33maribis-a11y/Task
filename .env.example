# OpenAI — only needed for AddTaskBar "AI" button / npm run ai:smoke
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# AI server (Node.js sidecar for LLM calls)
AI_SERVER_PORT=8787
NODE_ENV=development

# Optional: override dev proxy target from Vite
# VITE_AI_SERVER_URL=http://127.0.0.1:8787/api/ai

# Cursor Hooks audit → PostgreSQL (phase 2)
POSTGRES_HOST=172.16.57.201
POSTGRES_PORT=5432
POSTGRES_DB=cursor_audit
POSTGRES_USER=cursor_audit
POSTGRES_PASSWORD=change-me
# Or: DATABASE_URL=postgresql://cursor_audit:change-me@172.16.57.201:5432/cursor_audit

# Events API — local dev: http://127.0.0.1:8788  /  VM: http://172.16.57.201:8788
CURSOR_EVENTS_API_PORT=8788
CURSOR_EVENTS_API_URL=http://127.0.0.1:8788/api/events
CURSOR_EVENTS_PROJECT=task-manager

# Grafana (see grafana/README.md)
# Grafana UI: http://172.16.57.201:3001  (docker compose in grafana/)
