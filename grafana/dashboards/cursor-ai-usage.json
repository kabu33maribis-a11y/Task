          "rawSql": "SELECT\n  $__timeGroupAlias(recorded_at, $__interval, 0),\n  'input_tokens' AS metric,\n  COALESCE(SUM(input_tokens), 0) AS value\nFROM cursor_events\nWHERE event_type = 'afterAgentResponse'\n  AND $__timeFilter(recorded_at)\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroupAlias(recorded_at, $__interval, 0),\n  'output_tokens' AS metric,\n  COALESCE(SUM(output_tokens), 0) AS value\nFROM cursor_events\nWHERE event_type = 'afterAgentResponse'\n  AND $__timeFilter(recorded_at)\nGROUP BY 1\nORDER BY 1",
