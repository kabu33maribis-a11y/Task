      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-cursor" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.session_id,\n  MIN(s.recorded_at) FILTER (WHERE s.event_type = 'sessionStart') AS started_at,\n  MAX(s.recorded_at) FILTER (WHERE s.event_type = 'sessionEnd') AS ended_at,\n  COUNT(*) FILTER (WHERE e.event_type = 'postToolUse') AS tool_calls,\n  COUNT(*) FILTER (WHERE e.event_type = 'postToolUse' AND e.tool_name = 'Shell') AS shell_calls,\n  COUNT(*) FILTER (WHERE e.event_type = 'afterFileEdit') AS file_edits,\n  COALESCE(SUM(e.output_tokens) FILTER (WHERE e.event_type = 'afterAgentResponse'), 0) AS output_tokens\nFROM cursor_events s\nLEFT JOIN cursor_events e ON e.session_id = s.session_id\nWHERE $__timeFilter(s.recorded_at)\nGROUP BY s.session_id\nHAVING MIN(s.recorded_at) FILTER (WHERE s.event_type = 'sessionStart') IS NOT NULL\nORDER BY started_at DESC\nLIMIT 30",
          "refId": "A"
        }
      ],
      "title": "セッション一覧",
      "type": "table"
