{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "task-manager",
  "version": "0.1.0",
  "identifier": "jp.local.task-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "タスク管理",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMTEwMTM3OUEzNTIwQkIKUldTN0lEV2FOd0VSN2d1cmhVSmxtRlc4MGNFd0F2SUdLNXpzaG9lL0E2TkJyNHJFaVpudXA3Q0wK",
      "endpoints": [
        "https://github.com/kabu33maribis-a11y/Task/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
